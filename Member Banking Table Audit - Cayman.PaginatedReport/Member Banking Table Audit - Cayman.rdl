            <Textbox Name="textbox20">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>Member Banking Table Audit</Value>
                      <Style>
                        <FontFamily>Calibri</FontFamily>
                        <FontSize>12pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Center</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Top>0.43576in</Top>
              <Height>0.26458in</Height>
              <Width>13.94999in</Width>
              <Style>
                <Border>
                  <Style>None</Style>
                </Border>
                <PaddingLeft>2pt</PaddingLeft>
                <PaddingRight>2pt</PaddingRight>
                <PaddingTop>2pt</PaddingTop>
                <PaddingBottom>2pt</PaddingBottom>
              </Style>
            </Textbox>
            <Textbox Name="textbox19">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>
            =Switch(
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BS-GROUPER") &gt; 0 , "ATLANTIC MEDICAL INSURANCE LIMITED",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BS-FLAMINGO")&gt; 0 , "ATLANTIC MEDICAL INSURANCE LIMITED",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BB-PELICAN") &gt; 0 , "EC",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BB-DOLPHIN") &gt; 0 , "CORALISLE MEDICAL INSURANCE COMPANY LIMITED",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BB-MONGOOSE") &gt; 0 , "EC",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BM-CAHOW") &gt; 0 , "COLONIAL MEDICAL INSURANCE COMPANY LIMITED",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BM-WAHOO") &gt; 0 , "CORALISLE MEDICAL INSURANCE COMPANY LIMITED",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"KY-PARROT") &gt; 0 , "BRITISH CAYMANIAN INSURANCE AGENCIES LIMITED",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"KY-TURTLE") &gt; 0 , "BRITISH CAYMANIAN INSURANCE AGENCIES LIMITED",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"CG-ANGELFISH") &gt; 0 , "CORALISLE MEDICAL INSURANCE COMPANY LTD",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BILLOTRIX") &gt; 0 , "CORALISLE MEDICAL INSURANCE COMPANY LTD",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BILLOTRAX") &gt; 0 , "ATLANTIC MEDICAL INSURANCE LIMITED",
              instr( ucase(First(Fields!Server_Name.Value, "Server_Name")),"BILLTROX") &gt; 0 , "BRITISH CAYMANIAN INSURANCE AGENCIES LIMITED"
                     )
    </Value>
                      <Style>
                        <FontFamily>Calibri</FontFamily>
                        <FontSize>12pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Center</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Top>0.21076in</Top>

  <DataSets>
    <DataSet Name="Warehouse_Admin">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BranchName">
            <Value>=Parameters!BranchName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ProvLoc">
            <Value>=Parameters!ProvLoc.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Currency">
            <Value>=Parameters!Currency.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AccountStatus">
            <Value>=Parameters!AccountStatus.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PaymentType">
            <Value>=Parameters!PaymentType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DateFrom">
            <Value>=Parameters!DateFrom.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DateThru">
            <Value>=Parameters!DateThru.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT pb.provider_id as Provider_Id, Payee_name as Payee_Name, PB.Destination_Acct_Name as Account_Name,
 PB.Destination_Bank_Acct as Bank_Account,
PP.Destination_Bank_Code as Bank_Code, 
pb.Branch_Name as Branch_Name,
TC1.County_code + ' - '+ tc1.county_name as Bank_Country,
 PB.Currency_Code + ' - '+ tcr.currency_desc as Currency_Code,
Case when account_status = 'A' then 'Active'
	when account_status = 'I' then 'Inactive' end as Account_Status,
PB.Date_Status as Status_Date,
Case when pb.address_1 = ' ' then 'EFT' 
  else 'Wire'
end as Payment_Type,
Case when PB.destination_bank_acct_type = '20' then 'Savings'
	else 'Checking' end as Account_Type,
PB.Address_1 + ' ' + PB.city + ' ' + PB.state + ' ' + PB.zip_code as Address,
PB.User_Initials as User_Initials, PB.Date_Updated
, ib.Intermediary_BANK_NAME as IBank_Name, ib.Intermediary_BRANCH_NAME as IBranch_Name, ib.ADDRESS_1 as IAddress, ib.city as ICity,ib.state as IState,ib.county_code as ICounty_code,ib.zip_code as IZip_code,ib.phone as IPhone,
ib.swift_code as ISwift_Code, ib.ABA_ROUTING_NUMBER as IABA_Route,ib.SORT_CODE as ISort_code, ib.DIGIT_CHECKSUM as IDigit_Checksum, ib.bank_code as IBank_Code,
mc.Comment_line as Banking_Notes
FROM hcdb.dbo.provider_banking as PB
left outer join ADMNDB.dbo.INTERMEDIARY_BANKING IB
 on (ib.intermediary_id = pb.intermediary_id and pb.intermediary_id is not null) 
left join HCPPDB.dbo.TBL_COUNTY as TC1 on TC1.County_code = PB.Bank_Country
left join HCPPDB.dbo.TBL_CURRENCY TCR on TCR.CURRENCY_CODE = PB.CURRENCY_CODE
left Join hcdb.dbo.provider_payee as PP on PB.provider_id = PP.provider_id
left join 
 ( SELECT
    pt.provider_id,
    pt.type_comment,
    pt.date_updated,
    STUFF((
        SELECT ' ' + pt2.comment_line
        FROM hcdb.dbo.provider_text pt2
        WHERE pt2.provider_id = pt.provider_id
          AND pt2.type_comment = pt.type_comment
          AND pt2.date_updated = pt.date_updated
        ORDER BY pt2.seq_no
        FOR XML PATH(''), TYPE
    ).value('.', 'NVARCHAR(MAX)'), 1, 1, '') AS comment_line
FROM hcdb.dbo.provider_text pt 
WHERE pt.date_updated = (
    SELECT MAX(pt1.date_updated)
    FROM hcdb.dbo.provider_text pt1
    WHERE pt.provider_id = pt1.provider_id
      AND pt.type_comment = pt1.type_comment
      AND pt1.date_updated &lt;= CAST(GETDATE() AS DATE)
)
and pt.type_comment = 'B' 
GROUP BY pt.provider_id, pt.type_comment, pt.date_updated) as mc 
  on  mc.provider_id =  PB.provider_id 
  and mc.date_updated = PB.date_updated

WHERE ('All' in (@BranchName) or pb.Branch_Name in (@BranchName)) 
    and ('All' in (@ProvLoc) or pb.Bank_country in (@ProvLoc))
    and ('All' in (@Currency) or PB.CURRENCY_CODE in (@Currency))
	and (@AccountStatus = 'All' OR
	        (@AccountStatus = 'A' AND Account_Status = 'A') OR  
	        (@AccountStatus = 'I' AND Account_Status = 'I') OR
	         @AccountStatus = Account_Status)
	and (@PaymentType = 'All' OR
        (@PaymentType = 'E' AND pb.address_1 = ' ' ) OR
        (@PaymentType = 'W' AND pb.address_1 &lt;&gt; ' '))
    AND (
    (@DateFrom IS NULL OR @DateThru IS NULL) 
    OR 
    (PB.Date_Updated BETWEEN @DateFrom AND @DateThru)
        )
order by pb.provider_id</CommandText>
      </Query>
      <Fields>
        <Field Name="Provider_Id">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Provider_Id</DataField>
        </Field>
        <Field Name="Payee_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Payee_Name</DataField>
        </Field>
        <Field Name="Account_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Account_Name</DataField>
        </Field>
        <Field Name="Bank_Account">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Bank_Account</DataField>
        </Field>
        <Field Name="Bank_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Bank_Code</DataField>
        </Field>
        <Field Name="Branch_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Branch_Name</DataField>
        </Field>
        <Field Name="Bank_Country">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Bank_Country</DataField>
        </Field>
        <Field Name="Currency_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Currency_Code</DataField>
        </Field>
        <Field Name="Account_Status">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Account_Status</DataField>
        </Field>
        <Field Name="Status_Date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Status_Date</DataField>
        </Field>
        <Field Name="Payment_Type">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Payment_Type</DataField>
        </Field>
        <Field Name="Account_Type">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Account_Type</DataField>
        </Field>
        <Field Name="Address">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Address</DataField>
        </Field>
        <Field Name="User_Initials">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>User_Initials</DataField>
        </Field>
        <Field Name="Date_Updated">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Date_Updated</DataField>
        </Field>
        <Field Name="IBank_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IBank_Name</DataField>
        </Field>
        <Field Name="IBranch_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IBranch_Name</DataField>
        </Field>
        <Field Name="IAddress">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IAddress</DataField>
        </Field>
        <Field Name="ICity">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ICity</DataField>
        </Field>
        <Field Name="IState">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IState</DataField>
        </Field>
        <Field Name="ICounty_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ICounty_code</DataField>
        </Field>
        <Field Name="IZip_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IZip_code</DataField>
        </Field>
        <Field Name="IPhone">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>IPhone</DataField>
        </Field>
        <Field Name="ISwift_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ISwift_Code</DataField>
        </Field>
        <Field Name="IABA_Route">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IABA_Route</DataField>
        </Field>
        <Field Name="ISort_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ISort_code</DataField>
        </Field>
        <Field Name="IDigit_Checksum">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IDigit_Checksum</DataField>
        </Field>
        <Field Name="IBank_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IBank_Code</DataField>
        </Field>
        <Field Name="Banking_Notes">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Banking_Notes</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="BranchNameParameter">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProvLoc">
            <Value>=Parameters!ProvLoc.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT *
FROM (

SELECT DISTINCT Branch_Name
FROM hcdb.dbo.provider_banking as PB
--Join hcdb.dbo.provider as P on PB.provider_id = P.provider_id
--join hcppdb.dbo.tbl_prov_loc as TPL on P.prov_location = TPL.prov_location
--join HCPPDB.dbo.TBL_COUNTY as TC on TC.County_code = TPL.county_code
join HCPPDB.dbo.TBL_COUNTY as TC on TC.County_code = PB.Bank_country
WHERE PB.Bank_country in (@ProvLoc)

UNION
SELECT 'All'

)BN
ORDER BY case when BN.Branch_Name = 'All' then '0' 
	    else '1' + BN.Branch_Name end</CommandText>
      </Query>
      <Fields>
        <Field Name="Branch_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Branch_Name</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ProvLocParameter">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <CommandText>SELECT county_code,county_name, CodeName
FROM (

SELECT DISTINCT pb.BANK_COUNTRY as county_code, County_Name,pb.BANK_COUNTRY+' - '+county_name as CodeName
FROM hcppdb.dbo.tbl_county as TC
Join hcdb.dbo.provider_banking as PB on PB.BANK_COUNTRY = TC.County_Code
UNION

SELECT 'All' as county_code, 'All' as county_name, 'All' as CodeName


) CC

ORDER BY case when CC.county_code = 'All' then '0' 
	    else '1' + CC.county_code end
	    ;</CommandText>
      </Query>
      <Fields>
        <Field Name="county_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>county_code</DataField>
        </Field>
        <Field Name="County_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>county_name</DataField>
        </Field>
        <Field Name="CodeName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CodeName</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PaymentTypeParameter">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <CommandText>SELECT Prov_Payee_Type , PaymentType_Sort

FROM (
SELECT 'All' as Prov_Payee_Type , '000' as PaymentType_Sort

UNION

SELECT DISTINCT Case when Prov_Payee_Type = 'E' then 'EFT' 
	when Prov_Payee_Type = 'W' then 'Wire' 
                   when Prov_Payee_Type = 'U' then 'USPay'
	else ' ' end as Prov_Payee_Type, 
Prov_Payee_Type as PaymentType_Sort

FROM hcdb.dbo.provider_payee
) PT

ORDER BY PaymentType_Sort</CommandText>
      </Query>
      <Fields>
        <Field Name="Prov_Payee_Type">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Prov_Payee_Type</DataField>
        </Field>
        <Field Name="PaymentType_Sort">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PaymentType_Sort</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CurrencyCode">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <CommandText>
SELECT *
FROM (
select distinct tcr.CURRENCY_CODE , tcr.CURRENCY_DESC, 
 tcr.CURRENCY_CODE + ' - ' + tcr.CURRENCY_DESC as CodeDesc
from HCPPDB.dbo.TBL_CURRENCY as TCR
join hcdb.dbo.provider_banking as PB on PB.CURRENCY_CODE = TCR.CURRENCY_CODE

union

SELECT 'All', 'All', 'All'

) CC

ORDER BY case when CC.CURRENCY_CODE = 'All' then '0' 
	    else '1' + CC.CURRENCY_CODE end
;</CommandText>
      </Query>
      <Fields>
        <Field Name="CURRENCY_CODE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CURRENCY_CODE</DataField>
        </Field>
        <Field Name="CURRENCY_DESC">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CURRENCY_DESC</DataField>
        </Field>
        <Field Name="CodeDesc">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CodeDesc</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Server_Name">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <CommandText>Select @@ServerName as Server_Name</CommandText>
      </Query>
      <Fields>
        <Field Name="Server_Name">
          <DataField>Server_Name</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>

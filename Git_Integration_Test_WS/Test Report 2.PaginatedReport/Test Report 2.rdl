  <DataSources>
    <DataSource Name="warehouse_ADMIN">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=bs-grouper;Initial Catalog=ADMNDB</ConnectString>
        <Prompt>Specify a user name and password for data source warehouse_ADMIN:</Prompt>
      </ConnectionProperties>
      <rd:DataSourceID>94987e7c-0799-47a7-a16c-f2d841962fe2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="warehouse_ADMIN">
      <Query>
        <DataSourceName>warehouse_ADMIN</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FROMDATE">
            <Value>=Parameters!FROMDATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@THRUDATE">
            <Value>=Parameters!THRUDATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT
NP16K.USER_INITIALS,
NP16K.ENTRY_PROCESS,
SUM(NP16K.T1_CNT_MEDICAL) AS MEDICAL,
SUM(NP16K.T1_CNT_DENTAL) AS DENTAL,
SUM(NP16K.T1_CNT_VISION) AS VISION,
SUM(NP16K.T1_CNT_FLEX) AS FLEX,
SUM(NP16K.T1_CNT_PREAUTH) AS PREAUTH,
SUM(NP16K.T1_CNT_CLAIMS) AS TOTAL_CLAIMS,
ROUND(MAX(MPP25B.CNT_CLAIMS)/MAX(MPP25A.CNT_CLAIMS) *100,2) AS PCNT_OF_CLAIMS,
SUM(NP16K.T1_CNT_PENDED) AS PENDED,
SUM(NP16K.T1_CNT_DENIED) AS DENIED,
SUM(NP16K.T1_CNT_ADJUSTED) AS ADJUSTED,
SUM(NP16K.T1_CNT_ACCEPTED) AS ACCEPTED,
SUM(NP16K.T1_CNT_PROVIDERS) AS PROVIDERS,
CASE WHEN SUM(NP16K.T1_CNT_PROVIDERS) &gt; 0 AND MAX(MPP25B.CNT_ACCEPTED) &gt; 0 THEN
ROUND(MAX(MPP25B.CNT_PROVIDERS)/MAX(MPP25B.CNT_ACCEPTED),0) 
ELSE 0 END AS PROV_PER_CLAIM,
CASE WHEN SUM(NP16K.T1_CNT_PROVIDERS) &gt; 0 THEN
ROUND(MAX(MPP25B.AMT_PAYMENTS)/MAX(MPP25B.CNT_PROVIDERS) ,2)
ELSE 0.00 END AS PAID_PER_PROV,
SUM(case when NP16K.T1_CNT_CLAIMS  = 0 then 0 else 1 end ) AS DAYS_WORK

FROM 

INDEXED.DBO.NPPF16K NP16K
LEFT OUTER JOIN ADMNDB.DBO.FN_MPP25A(@FROMDATE,@THRUDATE) MPP25A ON 1 = 1
LEFT OUTER JOIN ADMNDB.DBO.FN_MPP25B(@FROMDATE,@THRUDATE) MPP25B ON NP16K.USER_INITIALS = MPP25B.USER_INITIALS AND
                                                    NP16K.ENTRY_PROCESS = MPP25B.ENTRY_PROCESS

WHERE
NP16K.PROCESSED_DATE BETWEEN @FROMDATE AND @THRUDATE


GROUP BY NP16K.USER_INITIALS,NP16K.ENTRY_PROCESS

UNION 

SELECT
'ZZZZ' AS USER_INITIALS,
'Z' AS ENTRY_PROCESS,
SUM(NP16K.T1_CNT_MEDICAL) AS MEDICAL,
SUM(NP16K.T1_CNT_DENTAL) AS DENTAL,
SUM(NP16K.T1_CNT_VISION) AS VISION,
SUM(NP16K.T1_CNT_FLEX) AS FLEX,
SUM(NP16K.T1_CNT_PREAUTH) AS PREAUTH,
SUM(NP16K.T1_CNT_CLAIMS) AS TOTAL_CLAIMS,
100.00 AS PCNT_CLAIMS_1,
SUM(NP16K.T1_CNT_PENDED) AS PENDED,
SUM(NP16K.T1_CNT_DENIED) AS DENIED,
SUM(NP16K.T1_CNT_ADJUSTED) AS ADJUSTED,
SUM(NP16K.T1_CNT_ACCEPTED) AS ACCEPTED,
SUM(NP16K.T1_CNT_PROVIDERS) AS PROVIDERS,
CASE WHEN SUM(NP16K.T1_CNT_PROVIDERS) &gt; 0 THEN
ROUND(MAX(MPP25A.CNT_PROVIDERS)/MAX(MPP25A.CNT_ACCEPTED),0) 
ELSE 0 END AS PROV_PER_CLAIM,
CASE WHEN SUM(NP16K.T1_CNT_PROVIDERS) &gt; 0 THEN
ROUND(MAX(MPP25A.AMT_PAYMENTS)/MAX(MPP25A.CNT_PROVIDERS) ,2)
ELSE 0.00 END AS PAID_PER_PROV,
Sum(MPP25A.CNT_DAYS_WORK)  AS DAYS_WORK

FROM 

INDEXED.DBO.NPPF16K NP16K
LEFT OUTER JOIN ADMNDB.DBO.FN_MPP25A(@FROMDATE,@THRUDATE) MPP25A ON 1 = 1
WHERE
NP16K.PROCESSED_DATE BETWEEN @FROMDATE AND @THRUDATE

ORDER BY USER_INITIALS,ENTRY_PROCESS</CommandText>
      </Query>
      <Fields>
        <Field Name="USER_INITIALS">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>USER_INITIALS</DataField>
        </Field>
        <Field Name="ENTRY_PROCESS">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ENTRY_PROCESS</DataField>
        </Field>
        <Field Name="MEDICAL">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>MEDICAL</DataField>
        </Field>
        <Field Name="DENTAL">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>DENTAL</DataField>
        </Field>
        <Field Name="VISION">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>VISION</DataField>
        </Field>
        <Field Name="FLEX">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>FLEX</DataField>
        </Field>
        <Field Name="PREAUTH">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>PREAUTH</DataField>
        </Field>
        <Field Name="TOTAL_CLAIMS">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>TOTAL_CLAIMS</DataField>
        </Field>
        <Field Name="PCNT_OF_CLAIMS">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>PCNT_OF_CLAIMS</DataField>
        </Field>
        <Field Name="PENDED">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>PENDED</DataField>
        </Field>
        <Field Name="DENIED">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>DENIED</DataField>
        </Field>
        <Field Name="ADJUSTED">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>ADJUSTED</DataField>
        </Field>
        <Field Name="ACCEPTED">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>ACCEPTED</DataField>
        </Field>
        <Field Name="PROVIDERS">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>PROVIDERS</DataField>
        </Field>
        <Field Name="PROV_PER_CLAIM">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>PROV_PER_CLAIM</DataField>
        </Field>
        <Field Name="PAID_PER_PROV">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>PAID_PER_PROV</DataField>
        </Field>
        <Field Name="DAYS_WORK">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>DAYS_WORK</DataField>
        </Field>
      </Fields>
    </DataSet>

  <Code>
    Public Function GetDateFromDefault() As Date
        Return DateSerial(Year(Now), Month(Now), 1).AddMonths(-1)
    End Function



    Public Function GetDateThruDefault() As Date
        Return DateSerial(Year(Now), Month(Now), 1).AddDays(-1)
    End Function</Code>

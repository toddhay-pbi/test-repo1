  <DataSets>
    <DataSet Name="Warehouse_Admin">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Country">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!Country.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BranchName">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!BranchName.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AccountStatus">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!AccountStatus.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Currency">
            <Value>=Parameters!Currency.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PaymentType">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!PaymentType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DateFrom">
            <Value>=Parameters!DateFrom.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DateThru">
            <Value>=Parameters!DateThru.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT distinct MB.Member_SSN as Cert_No, Name_First + ' ' + Name_Last as Member, 
MB.Destination_Acct_Name as Account_Name, MB.Destination_Bank_Acct, 
 mb.Branch_Name as Destination_Bank_Branch,
 mb.Bank_Country + ' - '+ tc1.county_name as Country_Code,
 MB.Currency_Code + ' - '+ tcr.currency_desc as Currency_Code, 
Case when account_status = 'A' then 'Active'
	when account_status = 'I' then 'Inactive' 
	when account_status = 'H' then 'Hold' else ' '
 end as Account_Status,  
MB.Date_Status as Status_Date, 
Case when mb.address_1 = ' ' then 'EFT' else 'Wire'
 end as Payment_Type, 
Case when MB.destination_bank_acct_type = '20' then 'Savings'
	else 'Checking' end as Account_Type, 
mb.Address_1 + ' ' + mb.city + ' ' + mb.state + ' ' + mb.zip_code as Address, 
MB.User_Initials as User_Initials, MB.Date_Updated,
 MB.Bank_Country+ ' - '+ tc1.county_name as Bank_Country
, ib.Intermediary_BANK_NAME as IBank_Name, ib.Intermediary_BRANCH_NAME as IBranch_Name, ib.ADDRESS_1 as IAddress, ib.city as ICity,ib.state as IState,ib.county_code as ICounty_code,ib.zip_code as IZip_code,ib.phone as IPhone,
ib.swift_code as ISwift_Code, ib.ABA_ROUTING_NUMBER as IABA_Route,ib.SORT_CODE as ISort_code, ib.DIGIT_CHECKSUM as IDigit_Checksum, ib.bank_code as IBank_Code,
mc.Comment_line as Banking_Notes
FROM hcdb.dbo.member_banking as MB
left outer join ADMNDB.dbo.INTERMEDIARY_BANKING IB
 on (ib.intermediary_id = mb.intermediary_id and mb.intermediary_id is not null) 
left Join admndb.dbo.member as M on MB.member_ssn = M.member_ssn
left Join admndb.dbo.member_name as MN 
on MN.member_ssn = M.member_ssn
   and 'm1' = MN.family_id 
   and m.group_no = MN.group_no
left join admndb.dbo.banking B
on mb.branch_name = b.branch_name
left join HCPPDB.dbo.TBL_COUNTY as TC1 on TC1.County_code = MB.BANK_COUNTRY
left join HCPPDB.dbo.TBL_CURRENCY TCR on TCR.CURRENCY_CODE = MB.CURRENCY_CODE 
left join 
 ( SELECT
    pt.member_ssn,
    pt.type_comment,
    pt.date_updated,
    STUFF((
        SELECT ' ' + pt2.comment_line
        FROM admndb.dbo.member_comments pt2
        WHERE pt2.member_ssn = pt.member_ssn
          AND pt2.type_comment = pt.type_comment
          AND pt2.date_updated = pt.date_updated
        ORDER BY pt2.seq_no
        FOR XML PATH(''), TYPE
    ).value('.', 'NVARCHAR(MAX)'), 1, 1, '') AS comment_line
FROM admndb.dbo.member_comments pt
WHERE pt.date_updated = (
    SELECT MAX(pt1.date_updated)
    FROM admndb.dbo.member_comments pt1
    WHERE pt.member_ssn = pt1.member_ssn
      AND pt.type_comment = pt1.type_comment
      AND pt1.date_updated &lt;= CAST(GETDATE() AS DATE)
)
and pt.type_comment = 'B' 
GROUP BY pt.member_ssn, pt.type_comment, pt.date_updated) as mc 
  on  mc.member_ssn =  MB.member_ssn 
  and mc.date_updated = MB.date_updated
WHERE   ('All' in (@BranchName) or mb.Branch_Name in (@BranchName)) 
	and ('All' in (@Country) or mb.Bank_Country in (@Country))
	and (@AccountStatus = 'All' OR
	        (@AccountStatus = 'A' AND Account_Status = 'A') OR  
	        (@AccountStatus = 'I' AND Account_Status = 'I') OR
	         @AccountStatus = Account_Status)
    and ('All' in (@Currency) or MB.CURRENCY_CODE in (@Currency))
    AND (
    (@DateFrom IS NULL OR @DateThru IS NULL) 
    OR 
    (MB.Date_Updated BETWEEN @DateFrom AND @DateThru)
        )
    and (@PaymentType = 'All' OR
        (@PaymentType = 'E' AND mb.address_1 = ' ') OR
        (@PaymentType = 'W' AND mb.address_1 &lt;&gt; ' ')
        )</CommandText>
      </Query>
      <Fields>
        <Field Name="Cert_No">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Cert_No</DataField>
        </Field>
        <Field Name="Member">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Member</DataField>
        </Field>
        <Field Name="Account_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Account_Name</DataField>
        </Field>
        <Field Name="Destination_Bank_Acct">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Destination_Bank_Acct</DataField>
        </Field>
        <Field Name="Destination_Bank_Branch">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Destination_Bank_Branch</DataField>
        </Field>
        <Field Name="Country_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Country_Code</DataField>
        </Field>
        <Field Name="Currency_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Currency_Code</DataField>
        </Field>
        <Field Name="Account_Status">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Account_Status</DataField>
        </Field>
        <Field Name="Status_Date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Status_Date</DataField>
        </Field>

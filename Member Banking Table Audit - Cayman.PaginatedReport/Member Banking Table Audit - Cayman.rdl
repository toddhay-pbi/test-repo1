            <Textbox Name="textbox21">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>= "Country : " &amp; Lookup(Parameters!Country.Value, Fields!BANK_COUNTRY.Value, Fields!County_Name.value, "CountryCodeParameter") &amp; System.Environment.NewLine &amp; "Branch Name : " &amp; Parameters!BranchName.Value &amp; System.Environment.NewLine &amp; "Account Status : " &amp; Switch(
    Parameters!AccountStatus.Value = "All", "All",
    Parameters!AccountStatus.Value = "A", "Active", 
    Parameters!AccountStatus.Value = "I", "InActive"
) &amp; System.Environment.NewLine &amp; "Payment Type : " &amp;  Switch(
    Parameters!PaymentType.Value = "All", "All",
    Parameters!PaymentType.Value = "E", "EFT", 
    Parameters!PaymentType.Value = "W", "Wire"
)</Value>
                      <Style>
                        <FontFamily>Calibri</FontFamily>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </TextRun>

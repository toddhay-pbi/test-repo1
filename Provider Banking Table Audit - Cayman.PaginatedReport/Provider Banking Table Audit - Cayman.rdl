                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Len(Trim(Fields!IBank_Name.Value &amp; "")) &gt; 0, Fields!IBank_Name.Value + ", ", "") + 
IIf(Len(Trim(Fields!IBranch_Name.Value &amp; "")) &gt; 0, Fields!IBranch_Name.Value + ", ", "") + 
IIf(Len(Trim(Fields!IAddress.Value &amp; "")) &gt; 0, Fields!IAddress.Value + ", ", "") + 
IIf(Len(Trim(Fields!ICity.Value &amp; "")) &gt; 0, Fields!ICity.Value + ", ", "") + 
IIf(Len(Trim(Fields!IState.Value &amp; "")) &gt; 0, Fields!IState.Value + ", ", "") + 
IIf(Len(Trim(Fields!IZip_code.Value &amp; "")) &gt; 0, Fields!IZip_code.Value + ", ", "") + 
IIf(Len(Trim(Fields!ICounty_code.Value &amp; "")) &gt; 0, Fields!ICounty_code.Value + " ", "") + 
IIf(IsNothing(Fields!IPhone.Value) OrElse Fields!IPhone.Value = 0, "",", "+ CStr(Fields!IPhone.Value))</Value>

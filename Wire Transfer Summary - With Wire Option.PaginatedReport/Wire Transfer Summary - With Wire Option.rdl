  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="warehouse_ADMIN">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=bb-dolphin;Initial Catalog=ADMNDB</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>3c059955-b37c-4a8a-83cc-13cf5406f1e2</rd:DataSourceID>
    </DataSource>
    <DataSource Name="BankTable">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=bb-dolphin;Initial Catalog=BANKDB</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>e1d4d61b-f42f-4062-a9ea-c7a034206145</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="warehouse_ADMIN">
      <Query>
        <DataSourceName>warehouse_ADMIN</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@DATE_FROM">
            <Value>=Parameters!DATE_FROM.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DATE_THRU">
            <Value>=Parameters!DATE_THRU.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ReconStatus">
            <Value>=Parameters!ReconStatus.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BankCode">
            <Value>=Parameters!BankCode.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>select
	Payee_ID,
	Payee_Name,
	bank_code,
	check_no,
	date_check,
	member_name,
	local_currency,
	sum(local_currency_amount) As LocalCurrencyAmt,
	payee_currency,
	sum(payee_currency_payment) as PayeeCurrencyAmount,
	sum(usd_payment) as USDCurrencyAmt,
	Transfer_method,
	Payment_status,
	address,
	city,
	Member_Phone_Number,
	bank_details,
	Bank_Account_Type,
	Bank_Account_Number,
	RECON_STATUS,
	Cleared_Date,
	comments,
	date_serv_from,
	claim_no,
	Bank_Routing_Number,
	Bank_ABA_Routing_Number,
	Bank_Swift_Code,
	IBank_Name,
	IBranch_Name,
	IAddress,
	ICity,
	IState,
	ICounty_code,
	IZip_code,
	IPhone,
	ISwift_Code,
	IABA_Route,
	ISort_code,
	IDigit_Checksum,
	IBank_Code,
	Subgroup_Name
from
	(
	Select
		b.Bank_Code,
		ap.Check_No,
		ap.Date_Check,
		--date_serv_from,
		ap.Payee_id + ' ' + ap.payee_suffix as Payee_ID,
		ap.Payee_Name,
		--c.Default_Curr,
		m2.name_first + ' ' + m2.name_last as Member_Name,
		ap.amt_payment as Local_Currency_Amount,
		ap.currency_payment   as Payee_Currency_Payment,
		c.Default_Curr as Local_Currency,
		ap.claim_no,
	case
		when ap.payee_type = 'M' then gs.subgroup_name
        else ''
	end as Subgroup_Name,
	case
		when ap.payee_type = 'M' then mb.currency_code
        when ap.payee_type = 'P' then pb.currency_code
        when m.dependent_id1 &lt;&gt; ' ' then dependent_id1
        when (ap.payee_type = 'T' and mb.address_1 &lt;&gt; ' ')  THEN 'WIRE'
        else c.default_curr
	end as Payee_Currency,
		round(ap.amt_payment * admndb.dbo.fn_exchange2(c.date_serv_from, c.default_curr), 2) as USD_Payment,
		c.date_serv_from , --as Conversion_Date,
	case 
		when ap.payee_type = 'P' and pb.address_1 &lt;&gt; ' ' then 'WIRE'
            when ap.payee_type = 'M'
		and mb.address_1 &lt;&gt; ' '   then 'WIRE'
		when ap.payee_type = 'O' then 'WIRE' 
        when ap.payee_type = 'T' and mb.address_1 &lt;&gt; ' '   then 'WIRE'
		else 'UNIDENTIFIED'
       end as Transfer_Method ,
		ap.recon_status,
		coalesce(ptC.Comments, mCC.Comments) as Comments,
		br.date_cleared as Cleared_Date,
		Case
			when check_status = 'P' then 'Payment'
			When check_status = 'V' then 'Voided'
			When check_status = 'S' then 'Stopped'
		end as Payment_Status,
		case
			when mb.branch_name is null then pb.branch_name
			else mb.branch_name
		end as Bank_Details,
		case
			when mb.destination_bank_acct is null then pb.DESTINATION_BANK_ACCT
			else mb.DESTINATION_BANK_ACCT
		end as Bank_Account_Number,
		case
			when mb.address_1 is null then pb.ADDRESS_1
			else mb.address_1
		end as Address,
		case
			when mb.city is null then pb.city
			else mb.city
		end as City,
case
    when ap.payee_type = 'P' then pa.phone
    else m.HOME_PHONE
end as Member_Phone_Number,
		isnull (case
			when mb.destination_bank_acct_type = '20' then 'Savings'
			when mb.destination_bank_acct_type = '26' then 'Checking'
			when mb.destination_bank_acct_type is not null then ' '
			else null
		end,
		case
			when pb.destination_bank_acct_type = '20' then 'Savings'
			when pb.destination_bank_acct_type = '26' then 'Checking'
			else ' '
		end) as Bank_Account_Type,
		bnk.ROUTING_NUMBER_IB as Bank_Routing_Number,
		bnk.ABA_ROUTING_NUMBER as Bank_ABA_Routing_Number,
		bnk.SWIFT_CODE as Bank_Swift_Code,
		ib.Intermediary_BANK_NAME as IBank_Name,
		ib.Intermediary_BRANCH_NAME as IBranch_Name,
		ib.ADDRESS_1 as IAddress,
		ib.city as ICity,
		ib.state as IState,
		ib.county_code as ICounty_code,
		ib.zip_code as IZip_code,
		ib.phone as IPhone,
		ib.swift_code as ISwift_Code,
		ib.ABA_ROUTING_NUMBER as IABA_Route,
		ib.SORT_CODE as ISort_code,
		ib.DIGIT_CHECKSUM as IDigit_Checksum,
		ib.bank_code as IBank_Code
	from
		hcdb.dbo.ap_payment ap
	inner join admndb..core_group cg on
		cg.group_no = ap.group_no
--		and cg.self_insured &lt;&gt; 'Y'
	Inner join bankdb.dbo.bank b On
	     b.bank_code = ap.bank_code
	inner join HCDB..CLAIM C on
		C.CLAIM_NO = ap.CLAIM_NO
	left outer join (
    select provider_id, max(phone) as phone
    from hcdb.dbo.provider_address
    where prov_addr_type = 'S'
      and date_thru is null
    group by provider_id
) pa on ap.payee_id = pa.provider_id
   and ap.payee_type = 'P'
	left join BANKDB..BANK_RECON BR on
		BR.BANK_CODE = ap.BANK_CODE
		and cast(br.DOCUMENT_NO as Int) = cast(ap.CHECK_NO as int)
	left join admndb.dbo.member_name m2 on
		m2.member_ssn = ap.member_ssn
		and m2.family_id = ap.family_id
		and m2.group_no = ap.group_no
	left outer join admndb.dbo.member m on
		c.group_no = m.group_no
		and c.subgroup_no = m.subgroup_no
		and ap.payee_id = m.member_ssn
		and ap.payee_type = 'M'
	left outer join ADMNDB.dbo.GROUP_SUBGROUP gs on
		     gs.group_no = m.group_no
		and c.subgroup_no = m.subgroup_no
	left outer join hcdb.dbo.provider_payee pp on
		ap.payee_id = pp.provider_id
    	left outer join admndb.dbo.member_comments mc on
		ap.payee_id = mc.member_ssn
		and ap.payee_type = 'M'
		and mc.TYPE_COMMENT = 'W'
		and mc.COMMENT_LINE = 'verified'
	left outer join hcdb.dbo.provider_text ptV on
		ap.payee_id = ptV.provider_id
		and ap.payee_type = 'P'
		and pTV.TYPE_COMMENT = 'W'
		and ptV.COMMENT_LINE = 'verified'
	left outer join (
		Select
			Provider_id,
			STRING_AGG(convert (varchar(max), rtrim(Comment_Line)), ' ' )  
as Comments
		from
			hcdb..PROVIDER_TEXT
		where
	  		TYPE_COMMENT = 'W'
			and Comment_Line &lt;&gt; 'verfied'
		group by
			provider_id ) ptC on
		ap.payee_id = ptC.provider_id
		and ap.payee_type = 'P'
	left outer join (
		Select
			member_ssn,
			STRING_AGG(convert (varchar(max), rtrim(Comment_Line)), ' ' ) as Comments
		from
			admndb.dbo.member_comments
		where
			TYPE_COMMENT = 'W'
			and Comment_Line &lt;&gt; 'verfied'
		group by
			member_ssn ) mCC on
		ap.payee_id = mCC.member_ssn
		and ap.payee_type = 'M'
   left outer join HCDB.dbo.MEMBER_BANKING mb on ap.payee_id = mb.member_ssn
		and (mb.account_status = 'A'
			and mb.date_status &lt;= ap.date_check
			or (mb.account_status = 'I'
				and mb.date_status &gt;= ap.date_check))
	left outer join hcdb.dbo.provider_banking pb
on
		ap.payee_id = pb.provider_id
		and (pb.account_status = 'A'
			and pb.date_status &lt;= ap.date_check
			or (pb.account_status = 'I'
				and pb.date_status &gt;= ap.date_check))
	left outer join ADMNDB.dbo.Banking Bnk
 on
		((bnk.branch_name = mb.branch_name
			and mb.branch_name is not null)
		or (bnk.branch_name = pb.branch_name
			and pb.branch_name is not null))
	left outer join ADMNDB.dbo.INTERMEDIARY_BANKING IB
 on
		((ib.intermediary_id = mb.intermediary_id
			and mb.intermediary_id is not null)
		or (ib.intermediary_id = pb.intermediary_id
			and pb.intermediary_id is not null))
	where
		ap.date_check between @DATE_FROM and @DATE_THRU
	  --and ap.date_check between m.DATE_EFFECTIVE and m.DATE_TERMINATED
	  and ap.cip_flag = ' ' and  ap.check_status &lt;&gt; 'R' And (b.bank_check_form = 'W' )
     -- and b.bank_code NOT IN ('JN01', 'VX02' )
	  and (@ReconStatus = 'All' or @ReconStatus = ap.recon_status )
      and  ( ' ' in (@BankCode) or  b.MICR_ACCOUNT_NO in (@BankCode))
	  and ((c.claim_type = 'F' and cg.self_insured = 'Y') or (cg.self_insured &lt;&gt; 'Y'))
	group by
		b.BANK_CODE,
		ap.check_no,
		ap.date_check,
		ap.Payee_id + ' ' + ap.payee_suffix ,
		ap.payee_name,
		c.default_curr,
		ap.amt_payment,
		ap.claim_no,
		m2.name_first + ' ' + m2.name_last,
		ap.currency_payment,
	case
		when ap.payee_type = 'M' then gs.subgroup_name
        else ''
	end,
	case
		when ap.payee_type = 'M' then mb.currency_code
        when ap.payee_type = 'P' then pb.currency_code
        when m.dependent_id1 &lt;&gt; ' ' then dependent_id1
        when (ap.payee_type = 'T' and mb.address_1 &lt;&gt; ' ')  THEN 'WIRE'
        else c.default_curr
	end,
		c.date_serv_from,
	case
        when ap.payee_type = 'P'
		and pb.address_1 &lt;&gt; ' ' then 'WIRE'
            when ap.payee_type = 'M'
		and mb.address_1 &lt;&gt; ' '   then 'WIRE'
		when ap.payee_type = 'O' then 'WIRE'
		when ap.payee_type = 'T' and mb.address_1 &lt;&gt; ' '   then 'WIRE'
		else 'UNIDENTIFIED'
       end ,
		ap.recon_status,
		coalesce(ptC.Comments, mCC.Comments) ,
		date_cleared ,
		Case
			when check_status = 'P' then 'Payment'
			When check_status = 'V' then 'Voided'
			When check_status = 'S' then 'Stopped'
		end,
		case
			when mb.branch_name is null then pb.branch_name
			else mb.branch_name
		end,
		case
			when mb.destination_bank_acct is null then pb.DESTINATION_BANK_ACCT
			else mb.DESTINATION_BANK_ACCT
		end,
		case
			when mb.address_1 is null then pb.ADDRESS_1
			else mb.address_1
		end,
		case
			when mb.city is null then pb.city
			else mb.city
		end,
case
    when ap.payee_type = 'P' then pa.phone
    else m.HOME_PHONE
end,
		round(ap.amt_payment * admndb.dbo.fn_exchange2(c.date_serv_from, c.default_curr), 2),
		isnull (case
			when mb.destination_bank_acct_type = '20' then 'Savings'
			when mb.destination_bank_acct_type = '26' then 'Checking'
			when mb.destination_bank_acct_type is not null then ' '
			else null
		end,
		case
			when pb.destination_bank_acct_type = '20' then 'Savings'
			when pb.destination_bank_acct_type = '26' then 'Checking'
			else ' '
		end),
		bnk.ROUTING_NUMBER_IB,
		bnk.ABA_ROUTING_NUMBER ,
		bnk.SWIFT_CODE ,
		ib.Intermediary_BANK_NAME,
		ib.Intermediary_BRANCH_NAME,
		ib.ADDRESS_1,
		ib.city,
		ib.state,
		ib.county_code,
		ib.zip_code,
		ib.phone,
		ib.swift_code,
		ib.ABA_ROUTING_NUMBER,
		ib.SORT_CODE,
		ib.DIGIT_CHECKSUM,
		ib.bank_code
	) X
group by
	Payee_ID,
	Payee_Name,
	bank_code,
	check_no,
	date_check,
	member_name,
	local_currency,
	payee_currency,
	Transfer_method,
	Payment_status,
	date_serv_from,
	address,
	city,
	Member_Phone_Number,
	bank_details,
	Bank_Account_Type,
	Bank_Account_Number,
	RECON_STATUS,
	Cleared_Date,
	comments,
	claim_no,
	Bank_Routing_Number,
	Bank_ABA_Routing_Number,
	Bank_Swift_Code,
	IBank_Name,
	IBranch_Name,
	IAddress,
	ICity,
	IState,
	ICounty_code,
	IZip_code,
	IPhone,
	ISwift_Code,
	IABA_Route,
	ISort_code,
	IDigit_Checksum,
	IBank_Code,
	Subgroup_Name
order by
	bank_code,
	payee_id ,
	check_no
	--order by payee_id,check_no</CommandText>
      </Query>
      <Fields>
        <Field Name="Payee_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Payee_ID</DataField>
        </Field>
        <Field Name="Payee_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Payee_Name</DataField>
        </Field>
        <Field Name="bank_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>bank_code</DataField>
        </Field>
        <Field Name="check_no">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>check_no</DataField>
        </Field>
        <Field Name="date_check">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>date_check</DataField>
        </Field>
        <Field Name="member_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>member_name</DataField>
        </Field>
        <Field Name="local_currency">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>local_currency</DataField>
        </Field>
        <Field Name="LocalCurrencyAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>LocalCurrencyAmt</DataField>
        </Field>
        <Field Name="payee_currency">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>payee_currency</DataField>
        </Field>
        <Field Name="PayeeCurrencyAmount">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>PayeeCurrencyAmount</DataField>
        </Field>
        <Field Name="USDCurrencyAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>USDCurrencyAmt</DataField>
        </Field>
        <Field Name="Transfer_method">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Transfer_method</DataField>
        </Field>
        <Field Name="Payment_status">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Payment_status</DataField>
        </Field>
        <Field Name="address">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>address</DataField>
        </Field>
        <Field Name="city">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>city</DataField>
        </Field>
        <Field Name="Member_Phone_Number">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Member_Phone_Number</DataField>
        </Field>
        <Field Name="bank_details">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>bank_details</DataField>
        </Field>
        <Field Name="Bank_Account_Type">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Bank_Account_Type</DataField>
        </Field>
        <Field Name="Bank_Account_Number">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Bank_Account_Number</DataField>
        </Field>
        <Field Name="RECON_STATUS">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>RECON_STATUS</DataField>
        </Field>
        <Field Name="Cleared_Date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Cleared_Date</DataField>
        </Field>
        <Field Name="comments">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>comments</DataField>
        </Field>
        <Field Name="date_serv_from">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>date_serv_from</DataField>
        </Field>
        <Field Name="claim_no">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>claim_no</DataField>
        </Field>
        <Field Name="Bank_Routing_Number">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Bank_Routing_Number</DataField>
        </Field>
        <Field Name="Bank_ABA_Routing_Number">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Bank_ABA_Routing_Number</DataField>
        </Field>
        <Field Name="Bank_Swift_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Bank_Swift_Code</DataField>
        </Field>
        <Field Name="IBank_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IBank_Name</DataField>
        </Field>
        <Field Name="IBranch_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IBranch_Name</DataField>
        </Field>
        <Field Name="IAddress">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IAddress</DataField>
        </Field>
        <Field Name="ICity">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ICity</DataField>
        </Field>
        <Field Name="IState">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IState</DataField>
        </Field>
        <Field Name="ICounty_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ICounty_code</DataField>
        </Field>
        <Field Name="IZip_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IZip_code</DataField>
        </Field>
        <Field Name="IPhone">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>IPhone</DataField>
        </Field>
        <Field Name="ISwift_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ISwift_Code</DataField>
        </Field>
        <Field Name="IABA_Route">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IABA_Route</DataField>
        </Field>
        <Field Name="ISort_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ISort_code</DataField>
        </Field>
        <Field Name="IDigit_Checksum">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IDigit_Checksum</DataField>
        </Field>
        <Field Name="IBank_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IBank_Code</DataField>
        </Field>
        <Field Name="Subgroup_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Subgroup_Name</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CheckDate">
      <Query>
        <DataSourceName>warehouse_ADMIN</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>select max(date_check ) 
--select max(date_serv_from ) 

from hcdb..ap_payment  as ap
--inner join hcdb.dbo.claim as c on ap.claim_no = c.claim_no

where Check_Status &lt;&gt; 'R'
   and cip_flag = ''</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField />
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Server_Name">
      <Query>
        <DataSourceName>warehouse_ADMIN</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>Select RJ.Jurisdiction,RJ.JurisdictionName,RJ.ServerName,RJ.JurisdictionTitle,SN.Server_Name
from
(Select @@ServerName as Server_Name) as SN
left outer join "cg-angelfish".warehouse.dbo.Report_Jurisdictions RJ
  on SN.Server_Name = RJ.ServerName</CommandText>
      </Query>
      <Fields>
        <Field Name="Jurisdiction">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Jurisdiction</DataField>
        </Field>
        <Field Name="Server_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Server_Name</DataField>
        </Field>
        <Field Name="JurisdictionName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>JurisdictionName</DataField>
        </Field>
        <Field Name="ServerName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ServerName</DataField>
        </Field>
        <Field Name="JurisdictionTitle">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>JurisdictionTitle</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Bank_Code">
      <Query>
        <DataSourceName>BankTable</DataSourceName>
        <CommandText>Select '    ' as bank_code, 1 as ord
union
SELECT distinct bank_code, 2 as ord FROM BANKDB.dbo.BANK 
WHERE MICR_ACCOUNT_NO &lt;&gt; ' '
order by ord, bank_code</CommandText>
      </Query>
      <Fields>
        <Field Name="bank_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>bank_code</DataField>
        </Field>
        <Field Name="ord">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>ord</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>

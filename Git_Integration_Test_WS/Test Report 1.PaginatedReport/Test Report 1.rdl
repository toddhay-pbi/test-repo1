  <DataSources>
    <DataSource Name="Warehouse_Admin">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=billtrox;Initial Catalog=EDI11;TrustServerCertificate=True</ConnectString>
        <Prompt>Specify a user name and password for data source Warehouse_Admin:</Prompt>
      </ConnectionProperties>
      <rd:DataSourceID>c4a31f6b-4eaa-4303-9c11-1895edc94fd7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Warehouse_Admin">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Date">
            <Value>=Parameters!Date.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>Select case when CountryCode is null then 'Unknown' else CountryCode end as CountryCode,
case when ProvID is null then 'Unknown' else ProvID end as ProvID,
case when PayeeName is null then 'Unknown' else PayeeName end as PayeeName,
count (distinct  HPClaimNo ) as Clm_Count,
Sum(TotCharge) as TotCharge
From vwDailyLog
where cast(dateclaim as date) =  @Date 
and ClaimLoc &lt;&gt; 'International' 
group by CountryCode, ProvID, PayeeName
order by  CountryCode, ProvID</CommandText>
      </Query>
      <Fields>
        <Field Name="CountryCode">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CountryCode</DataField>
        </Field>
        <Field Name="ProvID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ProvID</DataField>
        </Field>
        <Field Name="PayeeName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PayeeName</DataField>
        </Field>
        <Field Name="Clm_Count">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Clm_Count</DataField>
        </Field>
        <Field Name="TotCharge">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotCharge</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>

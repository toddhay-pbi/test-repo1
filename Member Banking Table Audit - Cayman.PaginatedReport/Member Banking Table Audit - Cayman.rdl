        </Field>
        <Field Name="IState">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IState</DataField>
        </Field>
        <Field Name="ICounty_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ICounty_code</DataField>
        </Field>
        <Field Name="IZip_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IZip_code</DataField>
        </Field>
        <Field Name="IPhone">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>IPhone</DataField>
        </Field>
        <Field Name="ISwift_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ISwift_Code</DataField>
        </Field>
        <Field Name="IABA_Route">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IABA_Route</DataField>
        </Field>
        <Field Name="ISort_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ISort_code</DataField>
        </Field>
        <Field Name="IDigit_Checksum">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IDigit_Checksum</DataField>
        </Field>
        <Field Name="IBank_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IBank_Code</DataField>
        </Field>
        <Field Name="Banking_Notes">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Banking_Notes</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="BranchNameParameter">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Country">
            <Value>=Parameters!Country.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT *
FROM (

SELECT DISTINCT Branch_Name
FROM hcdb.dbo.member_banking as MB
WHERE ( Bank_country in (@Country))

UNION
SELECT 'All'

)BN
ORDER BY case when BN.Branch_Name = 'All' then '0' 
	    else '1' + BN.Branch_Name end</CommandText>
      </Query>
      <Fields>
        <Field Name="Branch_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Branch_Name</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CountryCodeParameter">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <CommandText>SELECT *
FROM (

SELECT DISTINCT mb.BANK_COUNTRY , County_Name
FROM hcppdb.dbo.tbl_county as TC
Join hcdb.dbo.member_banking as MB on MB.BANK_COUNTRY = TC.County_Code
UNION

SELECT 'All', 'All'

) CC

ORDER BY case when CC.bank_country = 'All' then '0' 
	    else '1' + CC.bank_country end
	    ;</CommandText>
      </Query>
      <Fields>
        <Field Name="BANK_COUNTRY">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>BANK_COUNTRY</DataField>
        </Field>
        <Field Name="County_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>County_Name</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PaymentTypeParameter">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <CommandText>SELECT card_on_file , PaymentType_Sort

FROM (
SELECT 'All' as card_on_file , '000' as PaymentType_Sort

UNION

SELECT DISTINCT Case when Card_on_file = 'E' then 'EFT' 
	when card_on_file = '1' then 'Wire' 
	--when card_on_file = '2' then 'Draft' 
	end as card_on_file, 
card_on_file as PaymentType_Sort

FROM hcdb.dbo.member_banking as MB
Join admndb.dbo.member as M on MB.member_ssn = M.member_ssn
Join admndb.dbo.member_name as MN on MN.member_ssn = M.member_ssn
--WHERE account_status = 'A' 

) PT

ORDER BY PaymentType_Sort</CommandText>
      </Query>
      <Fields>
        <Field Name="card_on_file">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>card_on_file</DataField>
        </Field>
        <Field Name="PaymentType_Sort">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PaymentType_Sort</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Currency">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <CommandText>
SELECT *
FROM (
select distinct tcr.CURRENCY_CODE , tcr.CURRENCY_DESC, tcr.CURRENCY_CODE + ' - ' + tcr.CURRENCY_DESC as CodeDesc
from HCPPDB.dbo.TBL_CURRENCY as TCR
Join hcdb.dbo.member_banking as MB on MB.currency_code = TCR.Currency_code

union

SELECT 'All', 'All','All'

) CC

ORDER BY case when CC.CURRENCY_CODE = 'All' then '0' 
	    else '1' + CC.CURRENCY_CODE end
;</CommandText>
      </Query>
      <Fields>
        <Field Name="CURRENCY_CODE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CURRENCY_CODE</DataField>
        </Field>
        <Field Name="CURRENCY_DESC">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CURRENCY_DESC</DataField>
        </Field>
        <Field Name="CodeDesc">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CodeDesc</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Server_Name">
      <Query>
        <DataSourceName>Warehouse_Admin</DataSourceName>
        <CommandText>Select @@ServerName as Server_Name</CommandText>
      </Query>
      <Fields>
        <Field Name="Server_Name">
          <DataField>Server_Name</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>

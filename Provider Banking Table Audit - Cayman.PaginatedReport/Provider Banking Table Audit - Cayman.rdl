    </ReportSection>
  </ReportSections>
  <ReportParameters>
    <ReportParameter Name="ProvLoc">
      <DataType>String</DataType>
      <Prompt>Country</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>ProvLocParameter</DataSetName>
          <ValueField>county_code</ValueField>
          <LabelField>CodeName</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="AccountStatus">
      <DataType>String</DataType>
      <Prompt>Account Status</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>All</Value>
            <Label>All</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>A</Value>
            <Label>Active</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>I</Value>
            <Label>Inactive</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="BranchName">
      <DataType>String</DataType>
      <Prompt>Branch Name</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>BranchNameParameter</DataSetName>
          <ValueField>Branch_Name</ValueField>
          <LabelField>Branch_Name</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="PaymentType">
      <DataType>String</DataType>
      <Prompt>Payment Type</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>All</Value>
            <Label>All</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>E</Value>
            <Label>EFT</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>W</Value>
            <Label>Wire</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>U</Value>
            <Label>USPay</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="Currency">
      <DataType>String</DataType>
      <Prompt>Currency Code</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>CurrencyCode</DataSetName>
          <ValueField>CURRENCY_CODE</ValueField>
          <LabelField>CodeDesc</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="DateFrom">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value>= Today()</Value>
        </Values>
      </DefaultValue>
      <Prompt>Date From</Prompt>
    </ReportParameter>
    <ReportParameter Name="DateThru">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value>=Today()</Value>
        </Values>
      </DefaultValue>
      <Prompt>Date Thru</Prompt>
    </ReportParameter>
  </ReportParameters>

  <ReportParameters>
    <ReportParameter Name="DATE_FROM">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateSerial(Year(now), month(now), Day(Now)).AddDays (-7)</Value>
        </Values>
      </DefaultValue>
      <Prompt>Date From</Prompt>
    </ReportParameter>
    <ReportParameter Name="DATE_THRU">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateSerial(Year(now), month(now), Day(Now)).AddDays (-1)</Value>
        </Values>
      </DefaultValue>
      <Prompt>Date Thru</Prompt>
    </ReportParameter>
    <ReportParameter Name="ReconStatus">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>Recon Status</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>All</Value>
            <Label>All</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>C</Value>
            <Label>Cleared</Label>
          </ParameterValue>
          <ParameterValue>
            <Value />
            <Label>Not Cleared</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="BankCode">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value xml:space="preserve">    </Value>
        </Values>
      </DefaultValue>
      <Prompt>Wire Option</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>Bank_Code</DataSetName>
          <ValueField>bank_code</ValueField>
          <LabelField>bank_code</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
      <cl:ComponentMetadata>
        <cl:HideUpdateNotifications>true</cl:HideUpdateNotifications>
      </cl:ComponentMetadata>
    </ReportParameter>

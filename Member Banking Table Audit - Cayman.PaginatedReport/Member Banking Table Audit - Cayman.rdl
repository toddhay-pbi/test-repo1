          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IBranch_Name</DataField>
        </Field>
        <Field Name="IAddress">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IAddress</DataField>
